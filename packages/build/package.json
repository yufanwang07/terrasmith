{
  "name": "@terrasmith/build",
  "version": "0.1.0",
  "description": "Turns a Terrasmith project into a Beyond All Reason map archive",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": { "build": "tsc -b", "clean": "rm -rf dist *.tsbuildinfo" },
  "dependencies": {
    "@terrasmith/core": "0.1.0",
    "@terrasmith/format": "0.1.0",
    "@terrasmith/graph": "0.1.0"
  }
}

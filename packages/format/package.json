{
  "name": "@terrasmith/format",
  "version": "0.1.0",
  "description": "Read and write Spring/Recoil map formats (SMF, SMT, mapinfo.lua, .sd7/.sdz) — the format layer behind Terrasmith",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
